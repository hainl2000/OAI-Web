# Local development without Docker
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/olympicai
JWT_SECRET=please-change-me-to-a-random-string-of-at-least-32-bytes
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=50000

# Used by pytest (database is created automatically if missing)
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/olympicai_test
