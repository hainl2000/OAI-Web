# ---- Docker Compose (root) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=olympicai

# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/olympicai
JWT_SECRET=please-change-me-to-a-random-string-of-at-least-32-bytes
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# Frontend (server-side proxy target for /api/*)
API_URL=http://backend:8000
